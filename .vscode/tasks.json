{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "NOBI: Watchdog (supervise.py)",
      "type": "shell",
      "command": "${workspaceFolder}/_runtime/python/python.exe",
      "args": ["${workspaceFolder}/supervise.py"],
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "NOBI: Bento gate (bento_gate.py)",
      "type": "shell",
      "command": "${workspaceFolder}/_runtime/python/python.exe",
      "args": ["${workspaceFolder}/data_bento/bento_gate.py", "--print"],
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "NOBI: Bridge (nobi_bridge.py)",
      "type": "shell",
      "command": "${workspaceFolder}/_runtime/python/python.exe",
      "args": ["${workspaceFolder}/nobi_bridge.py", "--duration", "0"],
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "NOBI: Engine (run.py)",
      "type": "shell",
      "command": "${workspaceFolder}/_runtime/python/python.exe",
      "args": ["${workspaceFolder}/run.py", "--duration", "0", "--out", "${workspaceFolder}/../crypto-clob-ui/data-ui"],
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "NOBI: UI server (ui_server.py)",
      "type": "shell",
      "command": "${workspaceFolder}/_runtime/python/python.exe",
      "args": ["${workspaceFolder}/../crypto-clob-ui/ui_server.py", "--duration", "0"],
      "options": { "cwd": "${workspaceFolder}/../crypto-clob-ui" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "NOBI: Brain server (brain_server.py)",
      "type": "shell",
      "command": "${workspaceFolder}/_runtime/python/python.exe",
      "args": ["${workspaceFolder}/ai/brain_server.py", "--port", "8090"],
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "NOBI: START ALL (watchdog + bento gate)",
      "type": "shell",
      "command": "echo",
      "args": ["NOBI: starting ALL (supervise.py + bento_gate.py)..."],
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "dependsOn": [
        "NOBI: Watchdog (supervise.py)",
        "NOBI: Bento gate (bento_gate.py)"
      ],
      "dependsOrder": "parallel",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": [],
      "detail": "ONE-CLICK START: watchdog (supervise.py -> Bridge/Engine/UI/Brain) + DataBento gate. Ctrl+Shift+B."
    }
  ]
}