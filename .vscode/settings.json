{
  "python.defaultInterpreterPath": "${workspaceFolder}/_runtime/python/python.exe",
  "python.analysis.extraPaths": [
    "${workspaceFolder}"
  ],
  "python.terminal.activateEnvironment": false,
  "files.exclude": {
    "**/__pycache__": true,
    "**/*.pyc": true,
    "_runtime": true,
    "dist": true
  },
  "search.exclude": {
    "_runtime": true,
    "dist": true,
    "**/__pycache__": true
  },
  "terminal.integrated.cwd": "${workspaceFolder}",
  "git.autofetch": false
}